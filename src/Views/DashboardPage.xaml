<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PersonalFinance.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PersonalFinance.Models"
    xmlns:viewModels="clr-namespace:PersonalFinance.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:DashboardViewModel">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>

        <VerticalStackLayout
        Padding="15"
        Spacing="15">

            <!-- Expense Summary -->

            <Frame
            CornerRadius="12"
            Padding="15">

                <VerticalStackLayout Spacing="10">

                    <Label
                    Text="Expense Summary"
                    FontSize="16"
                    FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="Today" FontSize="15"/>

                        <Label
                        Grid.Column="1"
                        Text="{Binding TodayExpense, StringFormat='₹{0:N2}'}"
                        FontAttributes="Bold" FontSize="15"/>

                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="This Month" FontSize="13"/>

                        <Label
                        Grid.Column="1"
                        Text="{Binding ThisMonthExpense, StringFormat='₹{0:N2}'}"
                        FontAttributes="Bold" FontSize="13"/>

                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="This Year" FontSize="13"/>

                        <Label
                        Grid.Column="1"
                        Text="{Binding ThisYearExpense, StringFormat='₹{0:N2}'}"
                        FontAttributes="Bold" FontSize="13"/>

                    </Grid>

                </VerticalStackLayout>

            </Frame>

            <!-- Averages -->

            <Frame
            CornerRadius="12"
            Padding="15">

                <VerticalStackLayout Spacing="10">

                    <Label
                    Text="Expense Averages"
                    FontSize="16"
                    FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="Daily Average" FontSize="13"/>

                        <Label
                        Grid.Column="1"
                        Text="{Binding AverageDailyExpense, StringFormat='₹{0:N2}'}"
                        FontAttributes="Bold" FontSize="13"/>

                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="Monthly Average" FontSize="13"/>

                        <Label
                        Grid.Column="1"
                        Text="{Binding AverageMonthlyExpense, StringFormat='₹{0:N2}'}"
                        FontAttributes="Bold" FontSize="13"/>

                    </Grid>

                </VerticalStackLayout>

            </Frame>

            <Frame 
                CornerRadius="12"
            Padding="15">

                <VerticalStackLayout Spacing="10">

                    <Label
            Text="Top Spending Categories"
            FontSize="16"
            FontAttributes="Bold"/>

                    <CollectionView
            ItemsSource="{Binding CategorySummaries}"
            SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CategorySummary">

                                <Grid ColumnDefinitions="*,Auto">

                                    <Label
                            Text="{Binding Category}" FontSize="13"/>

                                    <Label
                            Grid.Column="1"
                            Text="{Binding Amount,
                                           StringFormat='₹{0:N0}'}"
                            FontAttributes="Bold" FontSize="13"/>

                                </Grid>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>