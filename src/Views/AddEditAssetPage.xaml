<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PersonalFinance.Views.AddEditAssetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PersonalFinance.ViewModels"
    xmlns:models="clr-namespace:PersonalFinance.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:AddEditAssetViewModel"
    Title="{Binding PageTitle}">

    <ScrollView>

        <VerticalStackLayout
            Padding="16"
            Spacing="12">

            <Border
                Padding="16"
                Stroke="{toolkit:AppThemeResource CardStrokeColor}"
                BackgroundColor="{toolkit:AppThemeResource CardBackgroundColor}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Name"
                        FontAttributes="Bold" />

                    <Entry
                        Placeholder="Enter asset name"
                        Text="{Binding Name}" />

                    <Label
                        Text="Asset Type"
                        FontAttributes="Bold" />

                    <Picker
                        Title="Select Asset Type"
                        ItemsSource="{Binding AssetTypes}"
                        SelectedItem="{Binding SelectedAssetType}"
                        ItemDisplayBinding="{Binding Name}" />

                    <Label
                        Text="Amount"
                        FontAttributes="Bold" />

                    <Entry
                        Placeholder="Enter amount"
                        Keyboard="Numeric"
                        Text="{Binding Amount}" />

                    <Label
                        Text="Notes"
                        FontAttributes="Bold" />

                    <Editor
                        Placeholder="Optional notes"
                        Text="{Binding Notes}"
                        AutoSize="TextChanges"
                        HeightRequest="120" />

                    <Button
                        Text="Save"
                        Command="{Binding SaveCommand}" />

                    <Button
                        Text="Delete"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsEditMode}"
                        BackgroundColor="{DynamicResource DangerColor}"
                        TextColor="{StaticResource White}" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>