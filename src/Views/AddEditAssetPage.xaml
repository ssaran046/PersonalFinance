<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PersonalFinance.Views.AddEditAssetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PersonalFinance.ViewModels"
    xmlns:models="clr-namespace:PersonalFinance.Models"
    x:DataType="viewModels:AddEditAssetViewModel"
    Title="{Binding PageTitle}">

    <ScrollView>

        <VerticalStackLayout
            Padding="16"
            Spacing="16">

            <!-- Name -->

            <Label
                Text="Name"
                FontAttributes="Bold" />

            <Entry
                Placeholder="Enter asset name"
                Text="{Binding Name}" />

            <!-- Asset Type -->

            <Label
                Text="Asset Type"
                FontAttributes="Bold" />

            <Picker
                Title="Select Asset Type"
                ItemsSource="{Binding AssetTypes}"
                SelectedItem="{Binding SelectedAssetType}"
                ItemDisplayBinding="{Binding Name}" />

            <!-- Amount -->

            <Label
                Text="Amount"
                FontAttributes="Bold" />

            <Entry
                Placeholder="Enter amount"
                Keyboard="Numeric"
                Text="{Binding Amount}" />

            <!-- Notes -->

            <Label
                Text="Notes"
                FontAttributes="Bold" />

            <Editor
                Placeholder="Optional notes"
                Text="{Binding Notes}"
                AutoSize="TextChanges"
                HeightRequest="120" />

            <!-- Save Button -->

            <Button
                Text="Save"
                Command="{Binding SaveCommand}" />

            <!-- Delete Button -->

            <Button
                Text="Delete"
                Command="{Binding DeleteCommand}"
                IsVisible="{Binding IsEditMode}"
                BackgroundColor="IndianRed"
                TextColor="White" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>