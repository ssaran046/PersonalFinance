<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PersonalFinance.Views.AssetTypesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PersonalFinance.Models"
    xmlns:viewModels="clr-namespace:PersonalFinance.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:AssetTypesViewModel"
    Title="Asset Types">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>

    <Grid>

        <CollectionView
            ItemsSource="{Binding AssetTypes}"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="40"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="No asset types found"
                        FontSize="16"
                        TextColor="{toolkit:AppThemeResource MutedTextColor}" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:AssetType">

                    <Border
                        Margin="10,4"
                        Padding="16"
                        BackgroundColor="{toolkit:AppThemeResource CardBackgroundColor}"
                        Stroke="{toolkit:AppThemeResource CardStrokeColor}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}},
                                                  Path=BindingContext.AssetTypeTappedCommand}"
                                CommandParameter="{Binding}" />

                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="{Binding Name}"
                                FontSize="15"
                                FontAttributes="Bold" />

                            <Label
                                Grid.Column="1"
                                Text="›"
                                FontSize="18"
                                TextColor="{toolkit:AppThemeResource ChevronTextColor}"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Text="+"
            WidthRequest="56"
            HeightRequest="56"
            CornerRadius="28"
            FontSize="22"
            Margin="20"
            HorizontalOptions="End"
            VerticalOptions="End"
            Command="{Binding AddAssetTypeCommand}" />

    </Grid>

</ContentPage>