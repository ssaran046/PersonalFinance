<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalFinance.Views.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PersonalFinance.Models"
    xmlns:viewModels="clr-namespace:PersonalFinance.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:CategoriesViewModel">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>

    <Grid>

        <CollectionView
            ItemsSource="{Binding Categories}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Category">

                    <Border
                        Margin="10,4"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2E}"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#404040}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}},
                                    Path=BindingContext.CategoryTappedCommand}"
                                CommandParameter="{Binding}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="2">

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="16"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="Default"
                                    FontSize="12"
                                    TextColor="Orange"
                                    IsVisible="{Binding IsDefault}" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="›"
                                FontSize="20"
                                TextColor="Gray"
                                VerticalOptions="Center" />

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Text="+"
            WidthRequest="60"
            HeightRequest="60"
            CornerRadius="30"
            FontSize="26"
            Margin="20"
            HorizontalOptions="End"
            VerticalOptions="End"
            Command="{Binding AddCategoryCommand}" />

    </Grid>

</ContentPage>