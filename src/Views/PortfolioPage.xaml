<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PersonalFinance.Views.PortfolioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PersonalFinance.Models"
    xmlns:viewModels="clr-namespace:PersonalFinance.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:PortfolioViewModel"
    Title="Portfolio">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>

    <Grid>

        <ScrollView>

            <VerticalStackLayout
                Padding="16"
                Spacing="16">

                <!-- Portfolio Value -->

                <Border
                    Padding="16"
                    BackgroundColor="{toolkit:AppThemeResource CardBackgroundColor}"
                    Stroke="{toolkit:AppThemeResource CardStrokeColor}">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout>

                        <Label
                            Text="Total Portfolio Value"
                            FontSize="14"
                            TextColor="{toolkit:AppThemeResource MutedTextColor}" />

                        <Label
                            Text="{Binding TotalPortfolioValue, StringFormat='₹ {0:N2}'}"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="{StaticResource SuccessColor}" />

                    </VerticalStackLayout>

                </Border>

                <!-- Asset Allocation -->

                <Label
                    Text="Asset Allocation"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="{toolkit:AppThemeResource HeaderAccentColor}" />

                <CollectionView
                    ItemsSource="{Binding AssetAllocations}"
                    SelectionMode="None">

                    <CollectionView.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:AssetAllocationSummary">

                            <Border
                                Margin="0,4"
                                Padding="12"
                                BackgroundColor="{toolkit:AppThemeResource CardBackgroundColor}"
                                Stroke="{toolkit:AppThemeResource CardStrokeColor}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Grid
                                    ColumnDefinitions="*,Auto">

                                    <VerticalStackLayout>

                                        <Label
                                            Text="{Binding AssetType}"
                                            FontAttributes="Bold"
                                            FontSize="14" />

                                        <Label
                                            Text="{Binding Amount,
                                                           StringFormat='₹ {0:N2}'}"
                                            FontSize="12"
                                            TextColor="{StaticResource SuccessColor}" />

                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Percentage,
                                                       StringFormat='{0:F1}%'}"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        VerticalOptions="Center" />

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- Assets -->

                <Label
                    Text="Assets"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="{toolkit:AppThemeResource HeaderAccentColor}" />

                <CollectionView
                    ItemsSource="{Binding Assets}"
                    SelectionMode="None">

                    <CollectionView.EmptyView>

                        <Label
                            Text="No assets found"
                            HorizontalOptions="Center"
                            TextColor="{toolkit:AppThemeResource MutedTextColor}" />

                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:Asset">

                            <Border
                                Margin="0,4"
                                Padding="12"
                                BackgroundColor="{toolkit:AppThemeResource CardBackgroundColor}"
                                Stroke="{toolkit:AppThemeResource CardStrokeColor}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}},
                                                          Path=BindingContext.AssetTappedCommand}"
                                        CommandParameter="{Binding}" />

                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto">

                                    <VerticalStackLayout
                                        Spacing="4">

                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="15"
                                            FontAttributes="Bold" />

                                        <Label
                                            Text="{Binding AssetType.Name}"
                                            FontSize="12"
                                            TextColor="{toolkit:AppThemeResource MutedTextColor}" />

                                        <Label
                                            Text="{Binding Amount,
                                                           StringFormat='₹ {0:N2}'}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource SuccessColor}" />

                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="1"
                                        Text="›"
                                        FontSize="18"
                                        TextColor="{toolkit:AppThemeResource ChevronTextColor}"
                                        VerticalOptions="Center" />

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>

        <!-- Floating Add Button -->

        <Button
            Text="+"
            WidthRequest="56"
            HeightRequest="56"
            CornerRadius="28"
            FontSize="22"
            Margin="20"
            HorizontalOptions="End"
            VerticalOptions="End"
            Command="{Binding AddAssetCommand}" />

    </Grid>

</ContentPage>