<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PersonalFinance.Views.AddEditAssetTypePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PersonalFinance.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:AddEditAssetTypeViewModel"
    Title="{Binding PageTitle}">

    <ScrollView>

        <VerticalStackLayout
            Padding="16"
            Spacing="12">

            <Border
                Padding="16"
                Stroke="{toolkit:AppThemeResource CardStrokeColor}"
                BackgroundColor="{toolkit:AppThemeResource CardBackgroundColor}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="{Binding PageTitle}"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Entry
                        Placeholder="Asset Type Name"
                        Text="{Binding Name}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="Delete"
                            Command="{Binding DeleteCommand}"
                            BackgroundColor="{DynamicResource DangerColor}"
                            TextColor="{StaticResource White}"
                            IsVisible="{Binding IsEditMode}" />

                        <Button
                            Grid.Column="1"
                            Text="Save"
                            Command="{Binding SaveCommand}" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>