<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PersonalFinance.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PersonalFinance.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:SettingsViewModel">

    <ScrollView>

        <VerticalStackLayout
            Padding="16"
            Spacing="12">

            <!-- Themes -->
            <Border
                Padding="16"
                Stroke="{toolkit:AppThemeResource CardStrokeColor}"
                BackgroundColor="{toolkit:AppThemeResource CardBackgroundColor}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="Themes"
                        FontSize="17"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="›"
                        FontSize="20"
                        TextColor="{toolkit:AppThemeResource ChevronTextColor}"
                        VerticalOptions="Center" />

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding OpenThemeOptionsCommand}" />
                    </Grid.GestureRecognizers>

                </Grid>

            </Border>

            <!-- Categories -->
            <Border
                Padding="16"
                Stroke="{toolkit:AppThemeResource CardStrokeColor}"
                BackgroundColor="{toolkit:AppThemeResource CardBackgroundColor}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="Categories"
                        FontSize="17"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="›"
                        FontSize="20"
                        TextColor="{toolkit:AppThemeResource ChevronTextColor}"
                        VerticalOptions="Center" />

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding OpenCategoriesCommand}" />
                    </Grid.GestureRecognizers>

                </Grid>

            </Border>

            <!-- Asset Types -->
            <Border
                Padding="16"
                Stroke="{toolkit:AppThemeResource CardStrokeColor}"
                BackgroundColor="{toolkit:AppThemeResource CardBackgroundColor}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="Asset Types"
                        FontSize="17"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="›"
                        FontSize="20"
                        TextColor="{toolkit:AppThemeResource ChevronTextColor}"
                        VerticalOptions="Center" />

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding OpenAssetTypesCommand}" />
                    </Grid.GestureRecognizers>

                </Grid>

            </Border>

            <!-- Backup/Restore -->
            <Border
                Padding="16"
                Stroke="{toolkit:AppThemeResource CardStrokeColor}"
                BackgroundColor="{toolkit:AppThemeResource CardBackgroundColor}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="Backup/Restore"
                        FontSize="17"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="›"
                        FontSize="20"
                        TextColor="{toolkit:AppThemeResource ChevronTextColor}"
                        VerticalOptions="Center" />

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding OpenBackupRestoreCommand}" />
                    </Grid.GestureRecognizers>

                </Grid>

            </Border>

            <!-- About -->
            <Border
                Padding="16"
                Stroke="{toolkit:AppThemeResource CardStrokeColor}"
                BackgroundColor="{toolkit:AppThemeResource CardBackgroundColor}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="About"
                        FontSize="17"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="›"
                        FontSize="20"
                        TextColor="{toolkit:AppThemeResource ChevronTextColor}"
                        VerticalOptions="Center" />

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding OpenAboutCommand}" />
                    </Grid.GestureRecognizers>

                </Grid>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>