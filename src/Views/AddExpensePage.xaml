<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PersonalFinance.Views.AddExpensePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PersonalFinance.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="viewModels:AddExpenseViewModel"
    Title="{Binding PageTitle}">

    <ScrollView>

        <VerticalStackLayout
            Padding="16"
            Spacing="12">

            <Border
                Padding="16"
                Stroke="{toolkit:AppThemeResource CardStrokeColor}"
                BackgroundColor="{toolkit:AppThemeResource CardBackgroundColor}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="{Binding PageTitle}"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Entry
                        Placeholder="Expense Name"
                        Text="{Binding Name}"
                        FontSize="16" />

                    <Picker
                        Title="Category"
                        FontSize="16"
                        ItemsSource="{Binding Categories}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedCategory}" />

                    <Entry
                        Placeholder="Amount"
                        FontSize="16"
                        Keyboard="Numeric"
                        Text="{Binding Amount}" />

                    <DatePicker
                        FontSize="16"
                        Date="{Binding Date}" />

                    <Editor
                        FontSize="16"
                        HeightRequest="100"
                        Placeholder="Notes"
                        Text="{Binding Notes}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="Delete"
                            FontSize="16"
                            BackgroundColor="{DynamicResource DangerColor}"
                            TextColor="{StaticResource White}"
                            IsVisible="{Binding IsEditMode}"
                            Command="{Binding DeleteCommand}" />

                        <Button
                            Grid.Column="1"
                            Text="Save"
                            FontSize="16"
                            Command="{Binding SaveCommand}" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
