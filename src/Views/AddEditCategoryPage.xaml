<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalFinance.Views.AddEditCategoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label
                Text="{Binding PageTitle}"
                FontSize="30"
                FontAttributes="Bold" />

            <Entry
                Placeholder="Category Name"
                FontSize="16"
                Text="{Binding Name}" />

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Text="Delete"
                    BackgroundColor="Red"
                    TextColor="White"
                    IsVisible="{Binding CanDelete}"
                    Command="{Binding DeleteCommand}" />

                <Button
                    Grid.Column="1"
                    Text="Save"
                    Command="{Binding SaveCommand}" />

            </Grid>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>