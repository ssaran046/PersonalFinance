<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PersonalFinance.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PersonalFinance"
    xmlns:views="clr-namespace:PersonalFinance.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="PersonalFinance">

    <TabBar>
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}"/>

        <ShellContent
            Title="Expenses"
            ContentTemplate="{DataTemplate views:ExpensesPage}"/>

        <ShellContent
            Title="Portfolio"
            ContentTemplate="{DataTemplate views:PortfolioPage}"/>
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}"/>
    </TabBar>
    

</Shell>
